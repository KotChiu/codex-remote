<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.remote</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.codex-remote/app/bin/codex-remote</string>
    <string>--port</string>
    <string>8787</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.codex-remote/app</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.codex-remote/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.codex-remote/bridge.err.log</string>
</dict>
</plist>
